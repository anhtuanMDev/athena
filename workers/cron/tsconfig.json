{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Type checks app modules that use the app's "~/" alias.
    "paths": { "~/*": ["../../app/*"] }
  },
  "include": ["src/**/*.ts"]
}
