{
  "$policy": {
    "limits": {
      "screensPerGame": 50,
      "blocksPerScreen": 60,
      "tabs": 5,
      "listItems": 100,
      "smallList": 12,
      "routeStops": 6,
      "text": 2000
    },
    "linkHosts": [
      "playoverwatch.com",
      "overwatch.blizzard.com",
      "news.blizzard.com",
      "blizzard.com",
      "marvelrivals.com",
      "youtube.com",
      "youtu.be"
    ],
    "imageHosts": [
      "blz-contentstack-images.akamaized.net",
      "bnetcmsus-a.akamaihd.net"
    ],
    "appScreens": [
      "app:settings"
    ],
    "blockedProps": "^(style|on[A-Z].*|children|ref|key)$",
    "patterns": {
      "gameSlug": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "recordId": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9.-]{0,78}[a-z0-9])?$",
      "screenId": "^[a-z0-9][a-z0-9-]*$",
      "category": "^[a-z][a-z0-9_]{0,39}$",
      "folder": "^[a-z][a-z0-9-]{0,39}$",
      "fieldKey": "^[a-z0-9_]+$",
      "boundLink": "^(data|item)\\.[A-Za-z0-9_.]+$",
      "color": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "assetVersion": "^[0-9a-f]{12}$"
    },
    "reservedFolders": [
      "imports",
      "syncs",
      "schemas",
      "screens",
      "enums",
      "assets",
      "navigation",
      "cron",
      "raw"
    ],
    "reservedCategories": [
      "cron_job"
    ],
    "imageVariants": [
      "main",
      "default",
      "2d",
      "portrait",
      "icon"
    ],
    "assetVersionLength": 12,
    "push": {
      "topic": "all_users",
      "androidChannel": "default"
    },
    "fixtures": {
      "categories.json": "58659f5f2b7e171c242801cfa55574bba7de869dddb6e13553c900e55e8b86fd",
      "contract-cases.json": "aa03ef7f6ac883b59b8cc1f59c2ba1c9fba27f1e7a1c694721679145db66a5fd",
      "contrast-cases.json": "302fbf8156afe5972d842b7128f2775232b9ed125845173b82041e47252cfe64",
      "palette-cases.json": "bb4b4f4c81455dd27ad8efe37e2d5aa1d591100c2f5c080f999ad6af3d6aa64c",
      "reference-folders-golden-items.json": "985f5adaf36e090f886f94b33511f42426bcfece80f42449735ec989ce4471c4",
      "reference-folders-golden.json": "f25d4317b0cb339066081a4e09472e9816629d7950d9572939482f641085f1c3"
    }
  },
  "screen_header": {
    "name": "ScreenHeader",
    "description": "ScreenHeader block",
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "subtitle": {
        "type": "string",
        "required": false
      },
      "showLogo": {
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Show the game's icon and name above the title."
      }
    }
  },
  "featured_carousel": {
    "name": "FeaturedCarousel",
    "description": "FeaturedCarousel block",
    "list": true,
    "props": {
      "eyebrow": {
        "type": "string",
        "required": false,
        "description": "Small label above each title, e.g. \"Featured hero\"."
      },
      "source": {
        "type": "source",
        "required": false
      },
      "itemTitle": {
        "type": "string",
        "required": true
      },
      "itemSubtitle": {
        "type": "string",
        "required": false
      },
      "itemText": {
        "type": "string",
        "required": false
      },
      "itemImage": {
        "type": "string",
        "required": false
      },
      "buttonLabel": {
        "type": "string",
        "required": false
      },
      "action": {
        "type": "action",
        "required": false
      },
      "variant": {
        "type": "data_binding",
        "options": [
          "banner",
          "cards"
        ],
        "required": false
      },
      "imageOverflow": {
        "type": "boolean",
        "required": false,
        "description": "Banner only: let the picture rise above the card (for cut-out art)."
      }
    }
  },
  "shortcut_grid": {
    "name": "ShortcutGrid",
