  "info_list": {
    "name": "InfoList",
    "description": "InfoList block",
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "rows": {
        "type": "info_rows",
        "required": true
      }
    }
  },
  "route_timeline": {
    "name": "RouteTimeline",
    "description": "RouteTimeline block",
    "list": true,
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "text": {
        "type": "string",
        "required": false
      },
      "items": {
        "type": "data_binding",
        "required": true,
        "description": "A list field of the record, e.g. \"data.route\"."
      },
      "itemLabel": {
        "type": "string",
        "required": true
      },
      "itemDetail": {
        "type": "string",
        "required": false
      }
    }
  },
  "gallery": {
    "name": "Gallery",
    "description": "Gallery block",
    "list": true,
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "items": {
        "type": "data_binding",
        "required": true,
        "description": "A list field of the record, e.g. \"data.gallery\"."
      },
      "itemImage": {
        "type": "string",
        "required": true
      },
      "itemCaption": {
        "type": "string",
        "required": false
      }
    }
  },
  "tips_card": {
    "name": "TipsCard",
    "description": "TipsCard block",
    "list": true,
    "props": {
      "title": {
        "type": "string",
        "required": false,
        "default": "Tips"
      },
      "items": {
        "type": "data_binding",
        "required": true,
        "description": "A list field of the record, e.g. \"data.tips\"."
      },
      "itemText": {
        "type": "string",
        "required": true
      },
      "image": {
        "type": "string",
        "required": false
      }
    }
  },
  "welcome_banner": {
    "name": "WelcomeBanner",
    "description": "WelcomeBanner block",
    "props": {
      "greeting": {
        "type": "string",
        "required": false,
        "default": "Welcome back",
        "description": "Shown above the player's first name, e.g. \"Welcome back\"."
      },
      "signedOutText": {
        "type": "string",
        "required": false,
        "description": "For signed-out players, with a sign-in button; leave empty to show them nothing."
      }
    }
  },
  "record_actions": {
    "name": "RecordActions",
    "description": "RecordActions block",
    "props": {
      "title": {
        "type": "string",
        "required": false,
        "description": "The record's name in a shared message, e.g. data.name."
      },
      "showFavorite": {
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Show the favorite button. On by default."
      },
      "showShare": {
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Show the share button. On by default."
      }
    }
  },
  "text": {
    "name": "Text",
    "description": "TextBlock block",
    "props": {
      "text": {
        "type": "string",
        "required": true
      },
      "variant": {
        "type": "data_binding",
        "options": [
          "display",
          "h1",
          "h2",
          "h3",
          "body",
          "bodySmall",
          "caption",
          "label",
          "overline"
        ],
        "required": false,
        "default": "body"
      },
      "color": {
        "type": "string",
        "required": false
      },
      "align": {
        "type": "data_binding",
        "options": [
          "left",
          "center",
          "right"
        ],
        "required": false
      },
      "weight": {
        "type": "data_binding",
        "options": [
          "400",
          "500",
          "600",
          "700",
          "800"
        ],
        "required": false
      }
    }
  },
  "field_section": {
    "name": "FieldSection",
    "description": "FieldSection block",
    "props": {
      "field": {
        "type": "data_binding",
        "required": true
      },
      "title": {
        "type": "string",
        "required": false
      }
    }
  },
  "badge": {
    "name": "Badge",
    "description": "Badge block",
    "props": {
      "label": {
        "type": "string",
        "required": true
      },
      "color": {
        "type": "string",
        "required": false
      },
      "textColor": {
        "type": "string",
        "required": false
      },
      "size": {
        "type": "data_binding",
        "options": [
          "sm",
          "md"
        ],
        "required": false,
        "default": "md"
      }
    }
  },
  "cover_entity_header": {
    "name": "CoverEntityHeader",
    "description": "CoverEntityHeader block",
    "props": {
      "title": {
        "type": "string",
        "required": true
      },
      "subtitle": {
        "type": "string",
        "required": false
      },
      "backgroundImage": {
        "type": "string",
        "required": false
      },
      "quote": {
        "type": "string",
        "required": false
      },
      "alignment": {
        "type": "data_binding",
        "options": [
          "left",
          "center"
        ],
        "required": false,
        "default": "left"
      }
    }
  },
  "feature_row_card": {
    "name": "FeatureRowCard",
    "description": "FeatureRowCard block",
    "props": {
      "title": {
        "type": "string",
        "required": true
      },
      "subtitle": {
        "type": "string",
        "required": false
      },
      "description": {
        "type": "string",
        "required": true
      },
      "image": {
        "type": "string",
        "required": true
      },
      "imagePosition": {
        "type": "data_binding",
        "options": [
          "left",
          "right"
        ],
        "required": false
      }
    }
  },
  "gradient_card": {
    "name": "GradientCard",
    "description": "GradientCard block",
    "props": {
      "title": {
        "type": "string",
        "required": true
      },
      "description": {
        "type": "string",
        "required": true
      },
      "footerText": {
        "type": "string",
        "required": false
      },
      "gradientColors": {
        "type": "array",
        "required": false
      }
    }
  },
  "horizontal_metric_row": {
    "name": "HorizontalMetricRow",
    "description": "HorizontalMetricRow block",
    "props": {
      "items": {
        "type": "array",
        "required": true
      }
    }
  },
  "linear_progress_card": {
    "name": "LinearProgressCard",
    "description": "LinearProgressCard block",
    "props": {
      "title": {
        "type": "string",
        "required": true
      },
      "level": {
        "type": "data_binding",
        "required": false
      },
      "currentXp": {
        "type": "number",
        "required": true
      },
      "maxXp": {
        "type": "number",
        "required": true
      },
      "badgeImage": {
        "type": "string",
        "required": false
      }
    }
  }
}
