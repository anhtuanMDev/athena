{
  "$policy": {
    "limits": {
      "screensPerGame": 50,
      "blocksPerScreen": 60,
      "tabs": 5,
      "listItems": 100,
      "smallList": 12,
      "routeStops": 6,
      "text": 2000
    },
    "linkHosts": [
      "playoverwatch.com",
      "overwatch.blizzard.com",
      "news.blizzard.com",
      "blizzard.com",
      "marvelrivals.com",
      "youtube.com",
      "youtu.be"
    ],
    "imageHosts": [
      "blz-contentstack-images.akamaized.net",
      "bnetcmsus-a.akamaihd.net"
    ],
    "appScreens": [
      "app:settings"
    ],
    "blockedProps": "^(style|on[A-Z].*|children|ref|key)$"
  },
  "screen_header": {
    "name": "ScreenHeader",
    "description": "ScreenHeader block",
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "subtitle": {
        "type": "string",
        "required": false
      },
      "showLogo": {
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Show the game's icon and name above the title."
      }
    }
  },
  "featured_carousel": {
    "name": "FeaturedCarousel",
    "description": "FeaturedCarousel block",
    "list": true,
    "props": {
      "eyebrow": {
        "type": "string",
        "required": false,
        "description": "Small label above each title, e.g. \"Featured hero\"."
      },
      "source": {
        "type": "source",
        "required": false
      },
      "itemTitle": {
        "type": "string",
        "required": true
      },
      "itemSubtitle": {
        "type": "string",
        "required": false
      },
      "itemText": {
        "type": "string",
        "required": false
      },
      "itemImage": {
        "type": "string",
        "required": false
      },
      "buttonLabel": {
        "type": "string",
        "required": false
      },
      "action": {
        "type": "action",
        "required": false
      },
      "variant": {
        "type": "data_binding",
        "options": [
          "banner",
          "cards"
        ],
        "required": false
      },
      "imageOverflow": {
        "type": "boolean",
        "required": false,
        "description": "Banner only: let the picture rise above the card (for cut-out art)."
      }
    }
  },
  "shortcut_grid": {
    "name": "ShortcutGrid",
    "description": "ShortcutGrid block",
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "items": {
        "type": "shortcuts",
        "required": true
      }
    }
  },
  "promo_card": {
    "name": "PromoCard",
    "description": "PromoCard block",
    "props": {
      "sectionTitle": {
        "type": "string",
        "required": false,
        "description": "Heading above the card, e.g. \"Latest news\"."
      },
      "eyebrow": {
        "type": "string",
        "required": false
      },
      "title": {
        "type": "string",
        "required": true
      },
      "text": {
        "type": "string",
        "required": false
      },
      "image": {
        "type": "string",
        "required": false
      },
      "buttonLabel": {
        "type": "string",
        "required": false
      },
      "action": {
        "type": "action",
        "required": false
      }
    }
  },
  "filter_chips": {
    "name": "FilterChips",
    "description": "FilterChips block",
    "props": {
      "field": {
        "type": "field_key",
        "required": true,
        "description": "Key of the field to filter on, e.g. \"role\"."
      },
      "allLabel": {
        "type": "string",
        "required": false,
        "default": "All"
      }
    }
  },
  "record_grid": {
    "name": "RecordGrid",
    "description": "RecordGrid block",
    "list": true,
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "showCount": {
        "type": "boolean",
        "required": false,
        "description": "Show how many records the list has next to the title."
      },
      "source": {
        "type": "source",
        "required": false
      },
      "itemLabel": {
        "type": "string",
        "required": true
      },
      "itemImage": {
        "type": "string",
        "required": false
      },
      "itemBadge": {
        "type": "string",
        "required": false
      },
      "columns": {
        "type": "number",
        "required": false,
        "default": "3"
      },
      "action": {
        "type": "action",
        "required": false
      }
    }
  },
  "detail_header": {
    "name": "DetailHeader",
    "description": "DetailHeader block",
    "props": {
      "eyebrow": {
        "type": "string",
        "required": false
      },
      "title": {
        "type": "string",
        "required": true
      },
      "quote": {
        "type": "string",
        "required": false
      },
      "image": {
        "type": "string",
        "required": false
      },
      "imageMode": {
        "type": "data_binding",
        "options": [
          "art",
          "background"
        ],
        "required": false,
        "default": "art"
      },
      "buttonLabel": {
        "type": "string",
        "required": false
      },
      "action": {
        "type": "action",
        "required": false
      }
    }
  },
  "tab_bar": {
    "name": "TabBar",
    "description": "TabBarBlock block",
    "props": {
      "tabs": {
        "type": "string",
        "required": true,
        "description": "Tab names separated by commas, e.g. \"Overview, Stats, Skins\"."
      }
    }
  },
  "item_list": {
    "name": "ItemList",
    "description": "ItemList block",
    "list": true,
    "props": {
      "title": {
        "type": "string",
        "required": false
      },
      "items": {
        "type": "data_binding",
        "required": true,
        "description": "A list field of the record, e.g. \"data.abilities\"."
      },
      "itemTitle": {
        "type": "string",
        "required": true
      },
      "itemSubtitle": {
        "type": "string",
        "required": false
      },
      "itemText": {
        "type": "string",
        "required": false
      },
      "itemImage": {
        "type": "string",
        "required": false
      }
    }
  },
