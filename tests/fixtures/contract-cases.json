{
 "description": "Shared contract cases: zms (__tests__/fixtures/contract-cases.json) and athena (tests/fixtures/contract-cases.json) run this same file, byte for byte. Its rules and how each side runs each section are in contract-spec.md. Its sha256 is in the block manifest's $policy.fixtures.",
 "enums": {
  "files": [
   {
    "id": "role",
    "name": "Role",
    "options": [
     "",
     "Tank",
     {
      "id": "damage",
      "name": "Damage",
      "icon": "/api/assets/overwatch/enums/role/damage.png"
     },
     {
      "id": "",
      "name": "Support"
     },
     {
      "name": ""
     },
     {
      "id": "flex"
     },
     5,
     null
    ]
   }
  ],
  "cases": [
   {
    "name": "global enum: the options a field offers, empty ones left out",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "damage",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": "Damage",
     "icon": "/api/assets/overwatch/enums/role/damage.png"
    }
   },
   {
    "name": "global enum: matched by name in any case",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "DAMAGE",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": "Damage",
     "icon": "/api/assets/overwatch/enums/role/damage.png"
    }
   },
   {
    "name": "global enum: a plain text option",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "Tank",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": "Tank",
     "icon": null
    }
   },
   {
    "name": "global enum: an option with an empty id is named by its name",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "support",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": "Support",
     "icon": null
    }
   },
   {
    "name": "global enum: an option with only an id",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "flex",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": "flex",
     "icon": null
    }
   },
   {
    "name": "global enum: an empty value names nothing",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": null,
     "icon": null
    }
   },
   {
    "name": "global enum: an unknown value names nothing",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "role"
    },
    "value": "healer",
    "expected": {
     "options": [
      "Tank",
      "damage",
      "Support",
      "flex"
     ],
     "name": null,
     "icon": null
    }
   },
   {
    "name": "global enum that doesn't exist",
    "field": {
     "key": "role",
     "type": "enum",
     "globalEnumId": "nope"
    },
    "value": "Tank",
    "expected": {
     "options": [],
     "name": null,
     "icon": null
    }
   },
   {
    "name": "inline options, empty ones left out",
    "field": {
     "key": "difficulty",
     "type": "enum",
     "options": [
      "",
      "Easy",
      "Hard"
     ]
    },
    "value": "hard",
    "expected": {
     "options": [
      "Easy",
      "Hard"
     ],
     "name": "Hard",
     "icon": null
    }
   },
   {
    "name": "inline options: a number value",
    "field": {
     "key": "tier",
     "type": "enum",
     "options": [
      "1",
      "2",
      "3"
     ]
    },
    "value": 3,
    "expected": {
     "options": [
      "1",
      "2",
      "3"
     ],
     "name": "3",
     "icon": null
    }
   },
   {
    "name": "a list field with inline options",
    "field": {
     "key": "affected_modes",
     "type": "list",
     "options": [
      "Quick Play",
      "Competitive Play"
     ]
    },
    "value": "competitive play",
    "expected": {
     "options": [
      "Quick Play",
      "Competitive Play"
     ],
     "name": "Competitive Play",
     "icon": null
    }
   }
  ]
 },
 "values": [
  {
   "name": "a whole number with its unit",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": 250
   },
   "expected": {
    "bound": "250 HP",
    "section": "250 HP"
   }
  },
  {
   "name": "decimals: bound as stored, a field section rounds to 2",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": 1.23456
   },
   "expected": {
    "bound": "1.23456 HP",
    "section": "1.23 HP"
   }
  },
  {
   "name": "rounding goes through toFixed(2), then drops trailing zeros",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": 2.005
   },
   "expected": {
    "bound": "2.005 HP",
    "section": "2 HP"
   }
  },
  {
   "name": "a negative decimal",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": -0.5
   },
   "expected": {
    "bound": "-0.5 HP",
    "section": "-0.5 HP"
   }
  },
  {
   "name": "zero keeps its unit",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": 0
   },
   "expected": {
    "bound": "0 HP",
    "section": "0 HP"
   }
  },
  {
   "name": "a number stored as text reads as a number",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": "250"
   },
   "expected": {
    "bound": "250 HP",
    "section": "250 HP"
   }
  },
  {
   "name": "text in a number field has no unit",
   "field": {
    "key": "health",
    "type": "number",
    "unit": "HP"
   },
   "record": {
    "health": "n/a"
   },
   "expected": {
    "bound": "n/a",
    "section": "n/a"
   }
  },
  {
   "name": "a number without a unit",
   "field": {
    "key": "team_count",
    "type": "number"
   },
   "record": {
    "team_count": 7
   },
   "expected": {
    "bound": "7",
    "section": "7"
   }
  },
  {
   "name": "the record's own suffix, trimmed, wins over the unit",
   "field": {
    "key": "cooldown",
    "type": "number",
    "unit": "s",
    "hasCustomSuffix": true
   },
   "record": {
    "cooldown": 6,
    "cooldown_suffix": " sec "
   },
   "expected": {
    "bound": "6 sec",
    "section": "6 sec"
   }
  },
  {
   "name": "a blank suffix falls back to the unit",
   "field": {
    "key": "cooldown",
    "type": "number",
    "unit": "s",
    "hasCustomSuffix": true
   },
   "record": {
    "cooldown": 6,
    "cooldown_suffix": "  "
   },
   "expected": {
    "bound": "6 s",
    "section": "6 s"
   }
  },
  {
   "name": "a suffix counts only when the field allows one",
   "field": {
    "key": "cooldown",
    "type": "number",
    "unit": "s"
   },
   "record": {
    "cooldown": 6,
    "cooldown_suffix": "sec"
   },
   "expected": {
    "bound": "6 s",
    "section": "6 s"
   }
  },
  {
   "name": "a text value takes the record's suffix",
   "field": {
    "key": "range",
    "type": "string",
    "hasCustomSuffix": true
   },
   "record": {
    "range": "long",
    "range_suffix": "m"
   },
   "expected": {
    "bound": "long m",
    "section": "long m"
   }
  },
  {
   "name": "a text value never takes the unit",
   "field": {
    "key": "label",
    "type": "string",
    "unit": "x"
   },
   "record": {
    "label": "abc"
   },
   "expected": {
    "bound": "abc",
    "section": "abc"
   }
  },
  {
   "name": "a flag: bound as true/false, Yes/No in a field section",
   "field": {
    "key": "is_symmetric",
    "type": "boolean"
   },
   "record": {
    "is_symmetric": true
   },
   "expected": {
    "bound": "true",
    "section": "Yes"
   }
  },
  {
   "name": "an enum never takes a unit",
   "field": {
    "key": "role",
    "type": "enum",
    "unit": "x",
    "options": [
     "Tank"
    ]
   },
   "record": {
    "role": "Tank"
   },
   "expected": {
    "bound": "Tank"
   }
  }
 ],
