{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    // Type checks app modules that use the app's "~/" alias.
    "paths": { "~/*": ["../app/*"] }
  },
  "include": ["**/*.ts"]
}
